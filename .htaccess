<IfModule mod_rewrite.c>
  RewriteEngine on
  RewriteBase /
  RewriteRule ^$ php/ [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ php/$1 [L]
</IfModule>

# CORS 許可
Header append Access-Control-Allow-Origin: "*"
Header append Access-Control-Allow-Headers: "*"
