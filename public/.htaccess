<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 1. 外部リダイレクト (SNS / ブログ)
  RewriteRule ^twitter/?$ https://twitter.com/jikantoki [R=301,L]
  RewriteRule ^youtube/?$ https://www.youtube.com/@jikantoki [R=301,L]
  RewriteRule ^blog/?$ https://blog.caramelos.xyz [R=301,L]

  # 2. uploads, download, customfiles は php/public/ 側に実体があるためそちらへリライト
  RewriteRule ^(uploads|download|customfiles)/(.*)$ /php/public/$1/$2 [L]

  # 3. 実在するファイルやディレクトリへのアクセスはそのまま配信
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. それ以外のリクエストをすべて index.html に書き換える
  RewriteRule ^.*$ /index.html [L]
</IfModule>
