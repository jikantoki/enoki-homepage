<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # uploads, download, customfiles は php/public/ 側に実体があるためそちらへリライト
  RewriteRule ^(uploads|download|customfiles)/(.*)$ /php/public/$1/$2 [L]

  # 実在するファイルやディレクトリへのアクセスはそのまま配信
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # それ以外のリクエストをすべて index.html に書き換える
  RewriteRule ^.*$ /index.html [L]
</IfModule>
