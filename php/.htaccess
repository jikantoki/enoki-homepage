<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /php/

  # 1. 外部リダイレクト (SNS / ブログ)
  RewriteRule ^twitter/?$ https://twitter.com/jikantoki [R=301,L]
  RewriteRule ^youtube/?$ https://www.youtube.com/@jikantoki [R=301,L]
  RewriteRule ^blog/?$ https://blog.caramelos.xyz [R=301,L]

  # 2. uploads, download, customfiles へのアクセスを public/ 配下へ転送
  RewriteRule ^(uploads|download|customfiles)/(.*)$ /php/public/$1/$2 [L]

  # 実在するファイルやディレクトリはそのまま配信
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, HEAD"
  Header set Access-Control-Allow-Headers "*"
  Header set Accept-Ranges bytes
</IfModule>
